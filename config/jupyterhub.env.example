# Optional environment file for systemd.
#
# To use:
#   sudo cp /opt/lab-server/config/jupyterhub.env.example /opt/lab-server/config/jupyterhub.env
#   sudo editor /opt/lab-server/config/jupyterhub.env
#   sudo systemctl restart jupyterhub
#
# Single-node Slurm setup:
# Leave these commented. JupyterHub and Slurm jobs are on the same host.

# Main TOML settings file. Use this only when you want a production override
# outside the repository-managed default, for example lab-server.local.toml.
#LAB_SERVER_CONFIG=/opt/lab-server/config/lab-server.local.toml

# Multi-node Slurm setup:
# Use a private login-node address reachable from compute nodes. Do not expose
# the Hub API to the public internet. Restrict access with firewall rules.
#LAB_SERVER_JUPYTERHUB_HUB_BIND_URL=http://10.0.0.10:8081
#LAB_SERVER_JUPYTERHUB_HUB_CONNECT_URL=http://10.0.0.10:8081

# Public proxy bind URL. Keep localhost when Nginx terminates HTTPS on the same
# host and proxies to JupyterHub.
#LAB_SERVER_JUPYTERHUB_BIND_URL=http://127.0.0.1:8000
