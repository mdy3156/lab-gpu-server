[Unit]
Description=JupyterHub for lab Slurm environment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/lab-server
EnvironmentFile=-/opt/lab-server/config/jupyterhub.env
ExecStart=/opt/lab-server/venv/bin/jupyterhub -f /opt/lab-server/config/jupyterhub_config.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
